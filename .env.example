# ─────────────────────────────── Transport ───────────────────────────────

HTTP_ADDR=:8088

# Where the recorded trend series is written. Redis keeps no history of its own,
# and this monitor deliberately does not write into the keyspace it reports on.
REDIS_MONITOR_DATA_DIR=data

# Only turn this on behind a proxy that sets X-Forwarded-For itself. A direct
# client can forge the header and hand itself a fresh rate-limit bucket.
REDIS_MONITOR_TRUST_PROXY=false

# ──────────────────────────────── Access ─────────────────────────────────
#
# Two ways in, and they are for different callers rather than alternatives:
#
#   username + password  → a person signs in and gets an expiring session
#   REDIS_MONITOR_TOKEN  → a static credential for scripts, curl and probes
#
# Either one alone is enough to boot. With neither, the binary refuses to start
# unless REDIS_MONITOR_DEV=true.

# Password login. Both must be set, or neither — a half-configured login is a
# boot error rather than a form nobody can satisfy. The page asks for these when
# they are set, and falls back to the token box when they are not.
REDIS_MONITOR_USERNAME=
REDIS_MONITOR_PASSWORD=

# How long a signed-in session lasts. Expiry slides on use, so a dashboard left
# open stays open; this is the idle timeout, not a hard deadline.
REDIS_MONITOR_SESSION_TTL=28800

# The static credential, sent as: Authorization: Bearer <token>
REDIS_MONITOR_TOKEN=change-me

# Set true only on a local box: it allows running with no credential at all.
REDIS_MONITOR_DEV=false

# The authenticator. Generate a secret and its enrolment URI with:
#
#   redis-monitor -totp-secret
#
REDIS_MONITOR_TOTP_SECRET=

# Deletes require a live 6-digit code. With this true and no secret set, deletes
# are refused outright — a misconfiguration is not a licence to delete without a
# code.
REDIS_MONITOR_REQUIRE_AUTHENTICATOR=true

# Extends the authenticator from the delete path to the login itself, so a leaked
# password alone does not get anybody in. Requires REDIS_MONITOR_TOTP_SECRET;
# setting this without one is a boot error rather than a silent downgrade.
#
# Note the code is single use across the whole binary: one that just let you sign
# in cannot also authorise a delete, so a delete in the same 30 seconds waits for
# the next code.
REDIS_MONITOR_REQUIRE_AUTHENTICATOR_ON_LOGIN=false

# ──────────────────────────────── Redis ──────────────────────────────────

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
# The literal string "null" is read as "no password", which is what a lot of
# tooling writes to mean "unset".
REDIS_PASSWORD=null
REDIS_TIMEOUT=3
REDIS_READ_TIMEOUT=10
REDIS_WRITE_TIMEOUT=10
REDIS_POOL_SIZE=10

# ─────────────────────────────── Feature ─────────────────────────────────

# false makes every /api/redis-monitor/* endpoint 404.
REDIS_MONITOR_ENABLED=true

# Label shown on the connection badge.
REDIS_MONITOR_CONNECTION=default

# Highest selectable database index; the UI offers 0..N.
REDIS_MONITOR_MAX_DB=15

# ──────────────────────────── Browsing limits ────────────────────────────

REDIS_MONITOR_PAGE_SIZE=50            # keys per SCAN page
REDIS_MONITOR_MAX_PAGE_SIZE=200       # hard cap on per_page
REDIS_MONITOR_SCAN_COUNT=500          # COUNT hint per SCAN call
REDIS_MONITOR_MAX_SCAN_ITERATIONS=200 # give up after this many SCAN round trips

# ──────────────────────── Overview sampling (charts) ─────────────────────

REDIS_MONITOR_SAMPLE_SIZE=2000        # keys sampled per refresh
REDIS_MONITOR_METRICS_CACHE=15         # seconds the overview is cached
REDIS_MONITOR_TOP_PREFIXES=10

# ─────────────────────── Namespace dropdown discovery ────────────────────

# Key names only, so no per-key round trip — a big sample is cheap here.
REDIS_MONITOR_NAMESPACE_SAMPLE_SIZE=20000
REDIS_MONITOR_NAMESPACE_CACHE=60
REDIS_MONITOR_MAX_NAMESPACES=200

# ──────────────────────── Key analytics deep sample ──────────────────────

# Four commands per key, pipelined one batch per SCAN page. The most expensive
# read on the screen, which is why it caches for longer.
REDIS_MONITOR_STATS_SAMPLE_SIZE=3000
REDIS_MONITOR_STATS_CACHE=60
REDIS_MONITOR_STATS_EXPIRY_DAYS=14
REDIS_MONITOR_STATS_TOP_NAMESPACES=12
REDIS_MONITOR_STATS_LARGEST_KEYS=10
REDIS_MONITOR_STATS_MEMORY=true       # false skips MEMORY USAGE (drops memory charts)
REDIS_MONITOR_STATS_IDLE=true         # false skips OBJECT IDLETIME (drops idle chart)

# ───────────────────────────── Trend history ─────────────────────────────

REDIS_MONITOR_HISTORY_ENABLED=true
REDIS_MONITOR_HISTORY_DAYS=30         # day buckets kept, and the widest UI range
REDIS_MONITOR_HISTORY_HOURS=48        # hour buckets kept
REDIS_MONITOR_HISTORY_MIN_INTERVAL=120 # seconds between two recorded points

# ──────────────────────────── Value previews ─────────────────────────────

REDIS_MONITOR_PREVIEW_BYTES=8192
REDIS_MONITOR_PREVIEW_ELEMENTS=100

# ─────────────────────────────── Delete ──────────────────────────────────

REDIS_MONITOR_ALLOW_DELETE=true       # false = strictly read-only screen
REDIS_MONITOR_MAX_DELETE=200          # keys per request
REDIS_MONITOR_CODE_REUSE_WINDOW=120   # seconds a spent code stays blacklisted

# ────────────────────────── Connected clients ────────────────────────────

REDIS_MONITOR_MAX_CLIENTS=500          # rows returned; a busier server is truncated
REDIS_MONITOR_CLIENTS_CACHE=5          # seconds a CLIENT LIST snapshot is reused

# ───────────────────────────── Rate limits ───────────────────────────────

REDIS_MONITOR_READ_RATE_LIMIT=120     # read requests per minute per IP
REDIS_MONITOR_DELETE_RATE_LIMIT=20    # delete requests per minute per IP
# Deliberately much tighter: login is the one endpoint where guessing pays off.
REDIS_MONITOR_LOGIN_RATE_LIMIT=10

# ────────────────────────────── Redaction ────────────────────────────────

# Both accept newline-separated Go (RE2) patterns and REPLACE the defaults, so an
# empty value means "redact nothing" rather than "use the defaults".
#
# REDIS_MONITOR_REDACT_KEY_PATTERNS   — a key whose NAME matches is never previewed
# REDIS_MONITOR_REDACT_VALUE_PATTERNS — masks secrets inside previewed values
